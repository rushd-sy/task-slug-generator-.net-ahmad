<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">True</GeneratePackageOnBuild>
    <Title>SlugGenerator</Title>
    <Authors>Ahmad Besher Dabbagh</Authors>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>Ahmad.SlugGenerator</PackageId>
    <Product>Ahmad.SlugGenerator</Product>
    <Description>Library that converts text into a URL-friendly slug and You can select any character as a separator.</Description>
    <Version>2.0.0</Version>
  </PropertyGroup>

</Project>
